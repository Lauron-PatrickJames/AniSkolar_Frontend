# Copy to .env.e2e (git-ignored) to run the signed-in Playwright tests.

# An existing user in the Clerk *development* instance. The tests sign in
# as this account, but every backend request is faked (e2e/mockApi.ts), so
# its real records are never read or changed.
E2E_STUDENT_EMAIL=

# The Clerk secret key (sk_test_...). Optional here: if it's missing, the
# tests read it from ../AniSkolar_Backend/.env.
CLERK_SECRET_KEY=

# Admin console tests: two office admin accounts (publicMetadata role
# "admin") in the Clerk development instance. The AdSO account sees every
# section; the office account (e.g. POLCA) checks the smaller menu. Every
# backend request is faked (e2e/mockAdminApi.ts).
E2E_ADSO_EMAIL=
E2E_OFFICE_EMAIL=
